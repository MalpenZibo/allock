# allock's polkit agent, for the graphical session.
#
# scripts/install.sh writes the binary's path in. Start it from the session
# (niri: `spawn-at-startup "systemctl" "--user" "start" "allock-polkit"`), or
# `systemctl --user enable allock-polkit` where graphical-session.target is
# reached. Only one agent can hold a session: stop any other first.

[Unit]
Description=allock polkit authentication agent
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=@BIN@ --polkit
Slice=session.slice
TimeoutStopSec=5sec
# Also when registering fails because polkitd is not up yet, or restarted.
Restart=on-failure
RestartSec=2sec

[Install]
WantedBy=graphical-session.target
